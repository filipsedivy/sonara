{
  "description": "A ~4 minute electronic track at 124 BPM in A minor: intro, build-up, two drops, breakdown, outro. Drums/bass/chords/lead generated per section, bass sidechained to the drums, reverb and delay buses, filter sweep automation in the build-up, master fade and limiter. Previews the first drop with per-track levels, exports WAV/FLAC/MP3 + MIDI and saves the project.",
  "steps": [
    {"id": "project", "tool": "create_project", "args": {"name": "Night Drive", "bpm": 124, "time_signature": "4/4", "length": "120 bars"}},
    {"tool": "set_metadata", "args": {"title": "Night Drive", "artist": "Sonara Examples", "genre": "Electronic"}},

    {"tool": "add_section", "args": {"name": "Intro", "start": "1:1", "length": "16 bars", "color": "#4a6fa5"}},
    {"tool": "add_section", "args": {"name": "Build-up", "start": "17:1", "length": "8 bars", "color": "#d9a24a"}},
    {"tool": "add_section", "args": {"name": "Drop 1", "start": "25:1", "length": "32 bars", "color": "#d9644a"}},
    {"tool": "add_section", "args": {"name": "Breakdown", "start": "57:1", "length": "16 bars", "color": "#5bb86b"}},
    {"tool": "add_section", "args": {"name": "Drop 2", "start": "73:1", "length": "32 bars", "color": "#d9644a"}},
    {"tool": "add_section", "args": {"name": "Outro", "start": "105:1", "length": "16 bars", "color": "#4a6fa5"}},

    {"id": "drums", "tool": "create_track", "args": {"name": "Drums", "kind": "instrument", "instrument": "sonara.drums", "preset": "Punchy 909", "color": "#d9644a"}},
    {"id": "bass", "tool": "create_track", "args": {"name": "Bass", "kind": "instrument", "preset": "Analog Bass", "color": "#d9a24a"}},
    {"id": "chords", "tool": "create_track", "args": {"name": "Chords", "kind": "instrument", "preset": "Warm Pad", "color": "#5bb86b"}},
    {"id": "lead", "tool": "create_track", "args": {"name": "Lead", "kind": "instrument", "preset": "Supersaw Lead", "color": "#a45bb8"}},
    {"id": "verb", "tool": "create_track", "args": {"name": "Reverb", "kind": "bus", "color": "#5b7db8"}},
    {"id": "delay", "tool": "create_track", "args": {"name": "Delay", "kind": "bus", "color": "#5ba8b8"}},

    {"tool": "add_effect", "args": {"track_id": "{{verb.result.track_id}}", "plugin_id": "sonara.reverb", "preset": "Concert Hall", "params": {"mix": 1.0}}},
    {"tool": "add_effect", "args": {"track_id": "{{delay.result.track_id}}", "plugin_id": "sonara.delay", "preset": "Dotted Eighth", "params": {"mix": 1.0}}},
    {"tool": "add_effect", "args": {"track_id": "{{bass.result.track_id}}", "plugin_id": "sonara.dynamics.compressor", "preset": "Sidechain Pump", "sidechain_source": "{{drums.result.track_id}}"}},
    {"id": "chfilter", "tool": "add_effect", "args": {"track_id": "{{chords.result.track_id}}", "plugin_id": "sonara.filter", "params": {"mode": "lowpass", "cutoff_hz": 12000, "resonance": 0.3}}},
    {"tool": "add_effect", "args": {"track_id": "{{lead.result.track_id}}", "plugin_id": "sonara.eq.parametric", "params": {"hp_on": true, "hp_freq": 200, "mid1_freq": 2500, "mid1_gain": 2.0}}},
    {"tool": "add_effect", "args": {"track_id": "master", "plugin_id": "sonara.dynamics.limiter", "preset": "Master -1 dBTP", "params": {"input_gain_db": 2.0}}},

    {"tool": "configure_routing", "args": {"track_id": "{{chords.result.track_id}}", "add_sends": [{"target": "{{verb.result.track_id}}", "level_db": -8}]}},
    {"tool": "configure_routing", "args": {"track_id": "{{lead.result.track_id}}", "add_sends": [{"target": "{{verb.result.track_id}}", "level_db": -10}, {"target": "{{delay.result.track_id}}", "level_db": -12}]}},

    {"tool": "generate_midi", "args": {"track_id": "{{drums.result.track_id}}", "kind": "drums", "style": "four_on_the_floor", "start": "1:1", "bars": 16, "variation": 0.1, "seed": 1, "name": "Intro Beat"}},
    {"tool": "generate_midi", "args": {"track_id": "{{drums.result.track_id}}", "kind": "drums", "style": "house", "start": "17:1", "bars": 8, "variation": 0.3, "seed": 2, "name": "Build Beat"}},
    {"tool": "generate_midi", "args": {"track_id": "{{drums.result.track_id}}", "kind": "drums", "style": "house", "start": "25:1", "bars": 32, "variation": 0.25, "seed": 3, "name": "Drop Beat"}},
    {"tool": "generate_midi", "args": {"track_id": "{{drums.result.track_id}}", "kind": "drums", "style": "house", "start": "73:1", "bars": 32, "variation": 0.3, "seed": 4, "name": "Drop 2 Beat"}},
    {"tool": "generate_midi", "args": {"track_id": "{{drums.result.track_id}}", "kind": "drums", "style": "four_on_the_floor", "start": "105:1", "bars": 16, "variation": 0.1, "fill": false, "seed": 5, "name": "Outro Beat"}},

    {"tool": "generate_midi", "args": {"track_id": "{{bass.result.track_id}}", "kind": "bass", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "offbeat", "octave": 2, "start": "17:1", "length": "8 bars", "name": "Build Bass"}},
    {"tool": "generate_midi", "args": {"track_id": "{{bass.result.track_id}}", "kind": "bass", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "octaves", "rate": 0.5, "octave": 2, "start": "25:1", "length": "32 bars", "name": "Drop Bass"}},
    {"tool": "generate_midi", "args": {"track_id": "{{bass.result.track_id}}", "kind": "bass", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "octaves", "rate": 0.5, "octave": 2, "start": "73:1", "length": "32 bars", "name": "Drop 2 Bass"}},
    {"tool": "generate_midi", "args": {"track_id": "{{bass.result.track_id}}", "kind": "bass", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "root", "octave": 2, "start": "105:1", "length": "8 bars", "name": "Outro Bass"}},

    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "sustain", "octave": 4, "velocity": 70, "start": "1:1", "length": "16 bars", "name": "Intro Pad"}},
    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "pulse8", "octave": 4, "velocity": 80, "start": "17:1", "length": "8 bars", "name": "Build Chords"}},
    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "offbeat", "octave": 4, "velocity": 85, "start": "25:1", "length": "32 bars", "name": "Drop Chords"}},
    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "sustain", "octave": 4, "velocity": 75, "start": "57:1", "length": "16 bars", "name": "Breakdown Pad"}},
    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "offbeat", "octave": 4, "velocity": 85, "start": "73:1", "length": "32 bars", "name": "Drop 2 Chords"}},
    {"tool": "generate_midi", "args": {"track_id": "{{chords.result.track_id}}", "kind": "chords", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "sustain", "octave": 4, "velocity": 65, "start": "105:1", "length": "16 bars", "name": "Outro Pad"}},

    {"tool": "generate_midi", "args": {"track_id": "{{lead.result.track_id}}", "kind": "melody", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "octave": 5, "rate": 0.5, "velocity": 96, "seed": 7, "start": "25:1", "length": "32 bars", "name": "Hook"}},
    {"tool": "generate_midi", "args": {"track_id": "{{lead.result.track_id}}", "kind": "arpeggio", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "style": "updown", "rate": 0.25, "octave": 4, "velocity": 70, "seed": 8, "start": "57:1", "length": "16 bars", "name": "Breakdown Arp"}},
    {"tool": "generate_midi", "args": {"track_id": "{{lead.result.track_id}}", "kind": "melody", "key": "A minor", "progression": ["i", "VI", "III", "VII"], "beats_per_chord": 8, "octave": 5, "rate": 0.5, "velocity": 100, "seed": 11, "start": "73:1", "length": "32 bars", "name": "Hook 2"}},

    {"tool": "create_automation", "args": {"track_id": "{{chords.result.track_id}}", "target": "{{chfilter.result.device_id}}:cutoff_hz", "points": [
      {"at": "1:1", "value": 900}, {"at": "16:1", "value": 1600},
      {"at": "17:1", "value": 400, "curve": "smooth"}, {"at": "25:1", "value": 12000, "curve": "hold"},
      {"at": "57:1", "value": 2500, "curve": "smooth"}, {"at": "73:1", "value": 12000, "curve": "hold"},
      {"at": "105:1", "value": 12000, "curve": "smooth"}, {"at": "121:1", "value": 600}]}},
    {"tool": "create_automation", "args": {"track_id": "master", "target": "volume", "points": [{"at": "113:1", "value": 0}, {"at": "121:1", "value": -40, "curve": "smooth"}]}},

    {"tool": "set_track_volume", "args": {"track_id": "{{drums.result.track_id}}", "volume_db": -6}},
    {"tool": "set_track_volume", "args": {"track_id": "{{bass.result.track_id}}", "volume_db": 6}},
    {"tool": "set_track_volume", "args": {"track_id": "{{chords.result.track_id}}", "volume_db": 3}},
    {"tool": "set_track_volume", "args": {"track_id": "{{lead.result.track_id}}", "volume_db": 0}},
    {"tool": "set_track_pan", "args": {"track_id": "{{lead.result.track_id}}", "pan": 0.1}},

    {"id": "state", "tool": "get_project_state", "args": {}},
    {"id": "drop_preview", "tool": "render_preview", "args": {"start": "25:1", "end": "41:1", "per_track_levels": true, "preroll_seconds": 2, "path": "examples/output/electronic_124bpm/drop1-preview.wav"}},
    {"id": "export", "tool": "export_audio", "confirm": true, "args": {"path": "examples/output/electronic_124bpm/night-drive.wav", "overwrite": true, "normalize": "loudness", "target_db": -14, "true_peak_ceiling_db": -1,
      "formats": [{"format": "wav", "bit_depth": 24}, {"format": "flac", "bit_depth": 24}, {"format": "mp3", "bitrate_kbps": 320}]}},
    {"tool": "export_midi", "confirm": true, "args": {"path": "examples/output/electronic_124bpm/night-drive.mid", "overwrite": true}},
    {"tool": "save_project", "confirm": true, "args": {"path": "examples/output/electronic_124bpm/Night Drive.sonara"}}
  ]
}
